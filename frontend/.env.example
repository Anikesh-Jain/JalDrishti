# JalDrishti Frontend Configuration (Non-secret only)
# Exposed to client-side application bundle via import.meta.env
# In production on Vercel, set VITE_API_URL to your Render backend URL (e.g. https://jaldrishti-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID for Google Identity Services (Client-side, non-secret)
# NEVER put client secrets in frontend environment files
VITE_GOOGLE_CLIENT_ID=

# Phase 16: Live Monitoring Telemetry Polling (Non-secret, defaults: 30000ms / 300000ms)
VITE_MONITORING_POLL_INTERVAL_MS=30000
VITE_MONITORING_STALE_AFTER_MS=300000
