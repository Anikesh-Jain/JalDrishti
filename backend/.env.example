# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/jaldrishti

# Client Origin
CLIENT_URL=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Rate Limiting Configuration (Phase 6)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=200

# Request Body Limit (Phase 6)
BODY_LIMIT=10kb

# Alert Debounce Configuration (Phase 9 - Implementation Choice, Configurable)
ALERT_DEBOUNCE_WINDOW_MS=900000

# SMS & Notification Configuration (Phase 10)
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=JALDRISHTI
SMS_RECIPIENT=+919876543210

# AI Water Image Screening Configuration (Phase 23)
AI_SCREENING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_SCREENING_MODEL=gemini-3.8-flash
IMAGE_MAX_SIZE_BYTES=5242880
RATE_LIMIT_IMAGE_WINDOW_MS=900000
RATE_LIMIT_IMAGE_MAX=20

# Outbound Email Delivery Configuration (Contact Inquiries)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="JalDrishti Support <support@jaldrishti.org>"
